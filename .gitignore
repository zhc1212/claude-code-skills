# Only track shareable skill/config files
# Exclude everything by default, then whitelist

*

# Whitelist shareable directories
!.gitignore
!README.md
!AGENTS.md
!workspace/
!workspace/**
!.claude-plugin/
!.claude-plugin/**
!marketplace.json
!plugin.json
!skills/
!skills/**
!agents/
!agents/**
!commands/
!commands/**
!hooks/
!hooks/**
!rules/
!rules/**
!scripts/
!scripts/**
!plugins/
!plugins/**

# Exclude caches and generated files inside whitelisted dirs
**/__pycache__/
**/*.pyc
**/node_modules/
**/cache/
**/.cache/
hooks/state/
plugins/cache/
skills/*/evals/results/

# User-level snapshots: keep private evaluation fixtures and local metadata out
**/.git/
**/.pytest_cache/
**/.venv/
skills/oral-paragraph-audit/evals/0[89]-*.yaml
skills/oral-paragraph-audit/evals/1[0-3]-*.yaml
skills/oral-paragraph-audit/evals/triggers/triggers.yaml
skills/notation-audit/evals/0[1-9]-*.yaml
skills/notation-audit/evals/triggers/triggers.yaml
skills/defensive-writing-sweep/evals/0[1-9]-*.yaml
skills/*/evals/results-*/
